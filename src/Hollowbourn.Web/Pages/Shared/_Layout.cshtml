<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hollowbourn</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Cinzel+Decorative:wght@700;900&family=MedievalSharp&family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=IM+Fell+English+SC&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/Hollowbourn.Web.styles.css" />
</head>
<body>
    <svg class="svg-defs" aria-hidden="true" hidden>
        <defs>
            <symbol id="divider-ornament" viewBox="0 0 200 30">
                <line x1="0" y1="15" x2="70" y2="15" stroke="currentColor" stroke-width="1" />
                <line x1="130" y1="15" x2="200" y2="15" stroke="currentColor" stroke-width="1" />
                <path d="M75,15 Q85,5 100,5 Q115,5 125,15 Q115,25 100,25 Q85,25 75,15 Z" fill="none" stroke="currentColor" stroke-width="1.2" />
                <circle cx="100" cy="15" r="3" fill="currentColor" />
                <line x1="70" y1="12" x2="70" y2="18" stroke="currentColor" stroke-width="1.5" />
                <line x1="130" y1="12" x2="130" y2="18" stroke="currentColor" stroke-width="1.5" />
            </symbol>
            <symbol id="ankh-icon" viewBox="0 0 40 40"></symbol>
            <symbol id="lightning-icon" viewBox="0 0 40 40"></symbol>
            <symbol id="skull-icon" viewBox="0 0 40 40"></symbol>
            <symbol id="crossed-swords-icon" viewBox="0 0 40 40"></symbol>
            <symbol id="eye-icon" viewBox="0 0 40 40"></symbol>
            <symbol id="note-icon" viewBox="0 0 40 40"></symbol>
        </defs>
    </svg>

    <nav class="main-nav" aria-label="Main navigation">
        <div class="nav-inner">
            <a class="nav-logo" asp-area="" asp-page="/Index">
                <span>Hollowbourn</span>
            </a>
            <ul class="nav-links">
                <li><a asp-area="" asp-page="/Index">Home</a></li>
                <li><a asp-area="" asp-page="/Pantheon">Pantheon</a></li>
                <li><a asp-area="" asp-page="/Index" asp-fragment="download">Download</a></li>
                <li><a asp-area="" asp-page="/Privacy">Privacy</a></li>
            </ul>
            <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <p class="footer-colophon"><strong>Hollowbourn</strong></p>
            <div class="footer-links">
                <a asp-area="" asp-page="/Index">Home</a>
                <span class="footer-sep">&bull;</span>
                <a asp-area="" asp-page="/Pantheon">Pantheon</a>
                <span class="footer-sep">&bull;</span>
                <a asp-area="" asp-page="/Privacy">Privacy</a>
            </div>
            <p class="footer-copy">&copy; 2026 CrazyPickle Studios. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

